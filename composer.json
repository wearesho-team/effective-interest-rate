{
    "name": "wearesho-team/effective-interest-rate",
    "description": "Effective interest rate (XIRR, effective APR) calculation. Fork of nyholm/effective-interest-rate for PHP 8.4+.",
    "type": "library",
    "keywords": [
        "effective interest rate",
        "effective interest",
        "XIRR",
        "effective APR",
        "bobra"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Nyholm",
            "email": "tobias.nyholm@gmail.com"
        },
        {
            "name": "Horat1us",
            "email": "reclamme@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "replace": {
        "nyholm/effective-interest-rate": "self.version"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Nyholm\\EffectiveInterest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nyholm\\EffectiveInterest\\Test\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 1800,
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "scripts": {
        "lint": "./vendor/bin/phpcs --standard=PSR12 ./src ./tests",
        "phpcbf": "./vendor/bin/phpcbf --standard=PSR12 ./src ./tests",
        "test": "./vendor/bin/phpunit",
        "cover": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --coverage-clover ./coverage.xml"
    }
}
